{
    "name": "tornado-engine/access-google",
    "description": "Tornado Engine module: gives roles to Google users, Google Groups and OUs, and keeps them in sync nightly.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "tornado-engine/access": ">=0.8",
        "tornado-engine/gam": ">=0.5",
        "tornado-engine/cron": ">=0.4"
    },
    "autoload": {
        "psr-4": {
            "TornadoEngine\\AccessGoogle\\": "src/"
        }
    },
    "extra": {
        "tornado": {
            "name": "Access-Google",
            "core": ">=0.21",
            "core-module": false,
            "provider": "TornadoEngine\\AccessGoogle\\AccessGoogleServiceProvider",
            "settings": "/access/google",
            "needs-setup": true
        },
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        }
    }
}
